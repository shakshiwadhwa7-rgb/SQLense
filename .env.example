APP_NAME=SQLense
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Groq (required for LLM features)
GROQ_API_KEY=your-groq-api-key-here

# PostgreSQL (required later for DB features)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sqlense

# ChromaDB (required later for RAG features)
CHROMA_PERSIST_DIR=./chroma_data
